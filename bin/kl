#!/usr/bin/env bash
# kl — kiln-lite session launcher.
#
# Wraps pi in a tmux session. Each invocation:
#   1. Generates a new agent-id (<name>-<adj>-<noun>).
#   2. Spawns a tmux session named after the agent-id.
#   3. Runs pi with the kiln-lite extension inside that session.
#   4. Attaches (or switch-client, if already in tmux).
#
# Agent home resolution (used by run, resume, history, doctor):
#   1. Positional <name> arg            -> $KL_AGENTS_DIR/<name>
#   2. $AGENT_HOME env var               -> use as-is (escape hatch for weird paths)
#   3. Default                           -> $KL_AGENTS_DIR/agent (the starter)
#   resume parses the session-id prefix (<name>-adj-noun) to pick the home
#   automatically — no need to set AGENT_HOME or pass a name.
#
# Subcommands:
#   kl run [<name>] [--detach] [--prompt-file FILE] [--parent NAME] [pi-args...]
#                           Spawn a new session. This is the canonical launch
#                           path.
#                           <name>: optional agent name (resolved against
#                             $KL_AGENTS_DIR). If omitted, uses AGENT_HOME or
#                             the default starter. A first positional that
#                             looks like a name but doesn't resolve to an
#                             installed agent errors (it is NOT spawned as the
#                             default agent with the token as a prompt).
#                           --detach (-d): don't attach; print agent-id to stdout.
#   kl [--detach] [pi-args...]
#                           Bare `kl` is an alias for `kl run` with the default
#                           agent (AGENT_HOME or the starter). Flags pass
#                           through. NOTE: `kl <name>` is NOT a shortcut for
#                           launching agent <name> — use `kl run <name>`.
#                           A bare unknown token is treated as an error, not a
#                           prompt.
#                           --parent NAME: record the agent-id that launched this
#                             session (e.g. your own $AGENT_ID when spawning a
#                             peer). Stored in the new session's meta.json and
#                             shown by `sessions --full`. Optional.
#                           --prompt-file FILE: read initial prompt from FILE and
#                             pass it to pi as --prompt. Use this instead of
#                             `kl --prompt "..."` for any prompt that contains
#                             backticks, $vars, or heredocs — the file path is
#                             inlined into the command but the file CONTENTS
#                             never go through a shell. Useful for spawning
#                             workers with long structured briefs.
#   kl resume <agent-id> [pi-args...]
#                           Resume a prior session BY NAME. Locates the owning
#                           agent home in order:
#                             1. Parse <name> prefix from <agent-id>; use that
#                                agent if the snapshot exists there.
#                             2. Scan every installed agent for the snapshot.
#                                Exactly one match wins; multiple -> hard error.
#                             3. $AGENT_HOME if explicitly set.
#                             4. Otherwise hard error.
#   kl attach <agent-id>    Attach an existing kl session.
#   kl init <name> [--full] Create an agent at $KL_AGENTS_DIR/<name>. Compact
#                           (default): agent.yml + SYSTEM.md. --full adds
#                           memory/ scratch/ extensions/ skills/ prompts/, a
#                           cleanup prompt, a memory section, and git init.
#                           That scaffolding is the only difference between
#                           a "persistent" and a simple agent. (`kl new` is an
#                           alias.)
#   kl list                 List active kl tmux sessions.
#   kl agents               List installed agents under $KL_AGENTS_DIR.
#   kl history [<name>]     Show recent sessions. Without <name>, walks all
#                           agents under $KL_AGENTS_DIR. With <name>, just that
#                           agent. -n N limits count; --all shows everything.
#   kl doctor [<name>]      Run a diagnostic. Without <name>, runs system
#                           checks + iterates all installed agents. With
#                           <name>, just that agent.
#   kl -h | --help          Show this help.
#
# Env:
#   KL_AGENTS_DIR           Parent dir for all agent homes (default: ~/.kl/agents).
#   AGENT_HOME              Explicit agent home path — bypasses the name lookup.
#                           Escape hatch for advanced/test setups.
#   KL_ROOT                 kl root (default: ~/.kl): config.yml + pi/ (the
#                           kl-wide PI_CODING_AGENT_DIR, created on first run).
#   KL_PI                   pi binary to run (default: the repo's
#                           node_modules/.bin/pi if present, else pi on PATH).
#
# Notes:
#   - tmux window name == agent-id. Collision is extremely unlikely but if it
#     happens kl appends a 2-byte hex suffix.
#   - AGENT_ID is exported into the tmux session env. The kiln-lite extension
#     prefers $AGENT_ID over UUID-derivation when set.
#   - Attach uses switch-client when already inside tmux.

set -euo pipefail

# --- resolve real script dir (follow symlinks — npm bin is symlinked) ---
# `npm link` creates two layers of symlinks: a direct symlink on the bin
# (`bin/kl` -> `node_modules/kiln-lite/bin/kl`) AND a symlinked DIRECTORY
# (`node_modules/kiln-lite` -> `~/Git/kiln-lite`). The readlink loop walks
# the first kind, but we need `cd -P` to resolve symlinked parent
# directories so REPO_ROOT ends up at the real on-disk path. Skipping -P
# leaves REPO_ROOT pointing at the npm-linked copy — any tooling that
# re-resolves paths relative to cwd or realpath can diverge from there,
# producing "kiln-lite not registered" style confusion.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
    _dir="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd -P)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$_dir/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd -P)"
REPO_ROOT="$(cd -P "$SCRIPT_DIR/.." && pwd -P)"

# The pi command line (extensions, skills, model/thinking defaults, the kl
# Pi agent dir) is built by src/launcher.ts from the merged ~/.kl/config.yml
# + agent.yml — see launcher_plan below. There is no harness override:
# agents extend kl with ordinary Pi extensions in <home>/extensions/.

# --- name pools (kept in sync with extensions/kiln-lite/identity.ts) ---
#
# If you edit either list, edit both. Short on purpose so dupe maintenance
# is trivial. Any divergence means a kl-launched session and an extension-
# generated id can't share vocabulary but no other breakage.
ADJECTIVES=(
    bright still deep coral ember iron jade thorn swift wild
    storm blue red shadow stone silver first dawn dusk quiet
    bold hollow gentle amber copper frost gold grey green lone
    loud misty moon north sharp sleek slow small snow soft
    south tall tame warm wise young ancient calm clear clever
    crisp fair fine glad keen lush mild neat proud rare
)
NOUNS=(
    raven hare falcon wren keep brook isle peak moth crane
    forge ridge jay pine haven pond marsh bear wolf fox
    stag otter owl lark finch hawk dove heron eagle thrush
    glade grove vale fen mesa cliff shore bay reef cove
    fjord loch dune moor heath cairn tower gate hall hearth
    barn mill forest wood copse trail path lane road bridge
)

die() { echo "kl: $*" >&2; exit 1; }

# --- agent-home resolution ---
#
# Single source of truth for "where does this agent live on disk?". Used
# by run/resume/history/doctor so the priority order stays consistent.
KL_AGENTS_DIR="${KL_AGENTS_DIR:-$HOME/.kl/agents}"

# Resolve an agent home from an optional name.
#
# Priority:
#   1. Explicit name        -> $KL_AGENTS_DIR/<name>   (must exist)
#   2. $AGENT_HOME env var  -> use as-is               (must exist)
#   3. Default              -> $KL_AGENTS_DIR/agent    (must exist)
#
# Exits non-zero with a helpful message if no agent can be resolved.
resolve_agent_home() {
    local name="${1:-}"
    if [ -n "$name" ]; then
        local home="$KL_AGENTS_DIR/$name"
        if [ -d "$home" ]; then
            printf '%s' "$home"; return
        fi
        die "no agent named '$name' at $home (use 'kl init $name' to create, or 'kl agents' to list)"
    fi
    if [ -n "${AGENT_HOME:-}" ]; then
        if [ -d "$AGENT_HOME" ]; then
            printf '%s' "$AGENT_HOME"; return
        fi
        die "AGENT_HOME=$AGENT_HOME does not exist"
    fi
    local default_home="$KL_AGENTS_DIR/agent"
    if [ -d "$default_home" ]; then
        printf '%s' "$default_home"; return
    fi
    die "no agent home found.
  Tried: \$KL_AGENTS_DIR/agent  -> $default_home
         \$AGENT_HOME            -> (unset)
  Run '$REPO_ROOT/install.sh' to scaffold a starter agent, or 'kl init <name>' to create one."
}

# Parse the agent-name prefix from a session-id like scout-bright-fox.
# Used by `kl resume` to figure out which agent home owns a snapshot
# without the caller having to set AGENT_HOME.
agent_name_from_session_id() {
    local id="$1"
    # Names match [a-z][a-z0-9_]* (hyphens reserved); adj+noun are word words.
    # The first dash separates name from adj.
    printf '%s' "${id%%-*}"
}

# Iterate installed agent homes (one per line). No output if none exist.
list_agent_homes() {
    [ -d "$KL_AGENTS_DIR" ] || return 0
    local d
    for d in "$KL_AGENTS_DIR"/*/; do
        [ -d "$d" ] || continue
        # Only count dirs that look like an agent home (have agent.yml).
        [ -f "${d}agent.yml" ] || continue
        # Strip trailing slash
        printf '%s\n' "${d%/}"
    done
}

usage() {
    # Print the top-of-file comment block (up to the first blank or non-comment line).
    awk '
        NR == 1 { next }                 # skip shebang
        /^[^#]/ { exit }                 # stop at first non-comment line
        /^#$/ { print ""; next }         # blank-comment -> blank line
        /^# ?/ { sub(/^# ?/, ""); print }
    ' "$SCRIPT_PATH"
    exit 1
}

# --- agent-id generation ---

# Deterministically derive an agent-id from a random seed.
# Mirrors extensions/kiln-lite/identity.ts shape: <name>-<adj>-<noun> via
# SHA-256 of a random seed, two 4-byte spans as indices.
generate_agent_id() {
    local name="${1:-agent}"
    # 16 bytes of entropy -> sha256 -> 64 hex chars
    local hex
    hex="$(head -c 16 /dev/urandom | shasum -a 256 | cut -d' ' -f1)"
    # First 4 bytes (8 hex) and next 4 bytes (8 hex) as unsigned ints.
    # Prefix with 0 and leading-zero-strip to avoid octal interpretation.
    local adj_raw noun_raw
    adj_raw="${hex:0:8}"
    noun_raw="${hex:8:8}"
    local adj_idx noun_idx
    adj_idx=$(( (16#${adj_raw}) % ${#ADJECTIVES[@]} ))
    noun_idx=$(( (16#${noun_raw}) % ${#NOUNS[@]} ))
    printf '%s-%s-%s' "$name" "${ADJECTIVES[$adj_idx]}" "${NOUNS[$noun_idx]}"
}

# Parse `name:` from agent.yml without bringing in a yaml dep. Trivial
# for the shape our scaffold uses; fine for more complex yaml too since we
# only match a top-level `name:` line.
resolve_agent_name() {
    local agent_home="${1:-$HOME/.kl/agent}"
    if [ -f "$agent_home/agent.yml" ]; then
        local n
        n="$(awk '/^name:[[:space:]]*/{sub(/^name:[[:space:]]*/,""); gsub(/[\"'\''[:space:]]/,""); print; exit}' "$agent_home/agent.yml")"
        if [ -n "$n" ]; then
            printf '%s' "$n"
            return
        fi
    fi
    printf 'agent'
}

# Parse `description:` from agent.yml. Returns empty if unset. Handles both
# inline form (description: "..." or bare) and YAML block scalars
# (description: | / >), emitting multi-line block content with its indentation
# stripped. Descriptions are prose, so we keep internal spaces and don't strip
# comments — only outer whitespace and one layer of quotes on the inline form.
resolve_agent_description() {
    local agent_home="$1"
    [ -f "$agent_home/agent.yml" ] || return 0
    awk '
        /^description:[[:space:]]*/ {
            line=$0
            sub(/^description:[[:space:]]*/, "", line)
            if (line ~ /^[|>]/) { block=1; next }   # block scalar: collect indented lines
            sub(/[[:space:]]+$/, "", line)
            sub(/^["'\'']/, "", line); sub(/["'\'']$/, "", line)
            print line; exit
        }
        block {
            if ($0 ~ /^[[:space:]]*$/) exit        # blank line ends the block
            if ($0 ~ /^[^[:space:]]/) exit         # dedent (next key/comment) ends it
            s=$0; sub(/^[[:space:]]+/, "", s); print s
        }
    ' "$agent_home/agent.yml"
}

# --- tmux helpers ---

require_tool() {
    local tool="$1" hint="${2:-}"
    command -v "$tool" >/dev/null 2>&1 || die "$tool not found on PATH${hint:+ — $hint}"
}

# Run the bundled state-cli (snapshot/journal reader) via tsx. tsx is a
# direct dependency, so it lives in the package's own node_modules; fall back
# to a PATH tsx if that's somehow absent. Always the bundled state-cli — the
# journal/snapshot logic is shared infra, not a per-agent harness override.
tsx_path() {
    local tsx_bin="$REPO_ROOT/node_modules/.bin/tsx"
    if [ ! -x "$tsx_bin" ]; then
        tsx_bin="$(command -v tsx 2>/dev/null || true)"
    fi
    [ -n "$tsx_bin" ] || die "tsx not found (expected $REPO_ROOT/node_modules/.bin/tsx — run install.sh)"
    printf '%s' "$tsx_bin"
}

run_tsx() {
    local tsx_bin
    tsx_bin="$(tsx_path)"
    "$tsx_bin" "$REPO_ROOT/extensions/kiln-lite/state-cli.ts" "$@"
}

# Ask src/launcher.ts for the pi invocation. Args: --home <home> [--resume]
# -- [user pi args...]. Sets PLAN_PI_DIR (PI_CODING_AGENT_DIR, created on
# first use), PLAN_NAME (validated agent name), PLAN_ARGS (pi argv).
# Config warnings print to stderr.
launcher_plan() {
    local tsx_bin tmp r
    tsx_bin="$(tsx_path)"
    tmp="$(mktemp "${TMPDIR:-/tmp}/kl-plan.XXXXXX")"
    if ! "$tsx_bin" "$REPO_ROOT/src/launcher.ts" plan "$@" > "$tmp"; then
        rm -f "$tmp"
        die "could not build the pi command (see above)"
    fi
    local -a recs=()
    while IFS= read -r -d '' r; do recs+=("$r"); done < "$tmp"
    rm -f "$tmp"
    [ ${#recs[@]} -ge 2 ] || die "launcher returned no plan"
    PLAN_PI_DIR="${recs[0]}"
    PLAN_NAME="${recs[1]}"
    PLAN_ARGS=("${recs[@]:2}")
}

# pi binary: $KL_PI, else the repo's pinned dev copy, else pi on PATH.
resolve_pi_bin() {
    if [ -n "${KL_PI:-}" ]; then
        [ -x "$KL_PI" ] || die "KL_PI=$KL_PI is not executable"
        printf '%s' "$KL_PI"; return
    fi
    if [ -x "$REPO_ROOT/node_modules/.bin/pi" ]; then
        printf '%s' "$REPO_ROOT/node_modules/.bin/pi"; return
    fi
    command -v pi 2>/dev/null || die "pi not found — install @earendil-works/pi-coding-agent >= 1.0.3 or set KL_PI"
}

# Enter a tmux session by switch-client if already inside tmux, else attach.
enter_session() {
    local session="$1"
    if [ -n "${TMUX:-}" ]; then
        exec tmux switch-client -t "$session"
    else
        exec tmux attach-session -t "$session"
    fi
}

# --- subcommands ---

cmd_run() {
    # Optional first positional: agent name. A bare word matching the agent
    # name grammar (^[a-z][a-z0-9_]*$ — no leading dash, no path separators) is
    # always interpreted as an intended agent name: if it resolves to an
    # installed agent under $KL_AGENTS_DIR we use it, otherwise
    # resolve_agent_home errors ("no agent named '<x>'"). This matches bare
    # `kl foo` erroring rather than silently spawning the DEFAULT agent with
    # the token as its first prompt. Anything that isn't a name-grammar word
    # (a flag like --detach, the `--` separator, or a multi-word/quoted
    # prompt) is left untouched for flag handling / pi pass-through — so
    # `kl --detach`, `kl -- foo`, and `kl run <name> "prompt"` all still work.
    local explicit_name=""
    if [ $# -gt 0 ] && [[ "$1" =~ ^[a-z][a-z0-9_]*$ ]]; then
        explicit_name="$1"
        shift
    fi

    local agent_home
    agent_home="$(resolve_agent_home "$explicit_name")"

    # Consume --detach / -d and --prompt-file out of args; everything else
    # is passed to pi. Accept leading or interspersed: `kl --detach foo` and
    # `kl -- foo` both work. --prompt-file FILE reads the file and appends
    # its contents to pi_args as the FINAL positional argument — pi's shape
    # is `pi [options] [@files...] [messages...]`, so the prompt goes at
    # the end. The contents live as a shell variable and reach pi via tmux's
    # execvp path, so they never get re-interpreted by a shell. That's the
    # whole point: write weird chars, backticks, heredoc-ish content into a
    # file and feed it in safely.
    local detach=0
    local pi_args=()
    local prompt_file=""
    local parent=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage ;;
            --detach|-d) detach=1 ;;
            --prompt-file)
                shift
                [ $# -ge 1 ] || die "--prompt-file requires a path argument"
                prompt_file="$1"
                ;;
            --prompt-file=*)
                prompt_file="${1#--prompt-file=}"
                ;;
            --parent)
                shift
                [ $# -ge 1 ] || die "--parent requires an agent-name argument"
                parent="$1"
                ;;
            --parent=*)
                parent="${1#--parent=}"
                ;;
            --) shift; pi_args+=("$@"); break ;;
            *) pi_args+=("$1") ;;
        esac
        shift
    done

    require_tool tmux "install with: brew install tmux"
    local pi_bin
    pi_bin="$(resolve_pi_bin)"

    # Extensions, skills, model/thinking defaults (explicit --model /
    # --thinking / --model id:level win) come from src/launcher.ts.
    launcher_plan --home "$agent_home" -- ${pi_args[@]+"${pi_args[@]}"}
    pi_args=(${PLAN_ARGS[@]+"${PLAN_ARGS[@]}"})

    if [ -n "$prompt_file" ]; then
        [ -f "$prompt_file" ] || die "--prompt-file: no such file: $prompt_file"
        local prompt_content
        prompt_content="$(cat "$prompt_file")" || die "--prompt-file: could not read $prompt_file"
        # Append as final positional — pi treats trailing args as the prompt.
        pi_args+=("$prompt_content")
    fi

    local name="$PLAN_NAME" agent_id
    agent_id="$(generate_agent_id "$name")"

    # If a tmux session already exists with this name, suffix until free.
    # Also avoid stomping a historical name that already has a snapshot meta
    # under state/sessions/ — collisions there break `kl resume <name>`
    # because reverse-lookup becomes ambiguous. Both checks happen at every
    # iteration of the suffixing loop.
    local snapshot_root="$agent_home/state/sessions"
    while tmux has-session -t "$agent_id" 2>/dev/null \
          || [ -e "$snapshot_root/$agent_id" ]; do
        agent_id="${agent_id}-$(head -c 2 /dev/urandom | od -An -tx1 | tr -d ' ')"
    done

    # --- pre-launch hook ---
    # If $AGENT_HOME/harness/pre-launch exists and is executable, run it
    # before spawning the tmux session. The hook can reject the launch by
    # exiting non-zero — its stderr is shown to the user in the calling
    # terminal. Useful for exclusive-role enforcement (e.g. coordinator
    # lock checks) without hardcoding policy into kl itself.
    local pre_launch="$agent_home/harness/pre-launch"
    if [ -x "$pre_launch" ]; then
        if ! AGENT_ID="$agent_id" AGENT_HOME="$agent_home" "$pre_launch"; then
            exit 1
        fi
    fi

    # Build the tmux command. -e passes env vars into the new session; we
    # export AGENT_ID (so the extension picks it up directly) and AGENT_HOME
    # (in case the caller's AGENT_HOME was inherited from shell, not set
    # explicitly). _KL=1 is a marker for the extension + future `kl` recursion.
    # PI_CODING_AGENT_DIR points pi at the kl-wide agent dir (never
    # ~/.pi/agent); KL_ROOT is forwarded because a running tmux server
    # doesn't see the caller's env.
    # Use ${arr[@]+"${arr[@]}"} idiom to safely expand an empty array under
    # `set -u` (bash treats a bare "${arr[@]}" on an empty array as unbound).
    local tmux_env_args=(
        -e "AGENT_ID=$agent_id"
        -e "AGENT_HOME=$agent_home"
        -e "_KL=1"
        -e "PI_CODING_AGENT_DIR=$PLAN_PI_DIR"
    )
    if [ -n "${KL_ROOT:-}" ]; then
        tmux_env_args+=(-e "KL_ROOT=$KL_ROOT")
    fi
    if [ -n "$parent" ]; then
        tmux_env_args+=(-e "KL_PARENT=$parent")
    fi

    tmux new-session -d -s "$agent_id" \
        ${tmux_env_args[@]+"${tmux_env_args[@]}"} \
        "$pi_bin" ${pi_args[@]+"${pi_args[@]}"}

    if [ "$detach" = 1 ]; then
        # Peer-spawn mode: agent-id on stdout (for capture), log on stderr.
        # Canonical idiom: id=$(kl --detach --prompt "...")
        echo "kl: spawned $agent_id (detached)" >&2
        echo "$agent_id"
        return 0
    fi

    echo "kl: spawned $agent_id" >&2
    enter_session "$agent_id"
}

cmd_attach() {
    [ $# -ge 1 ] || die "attach requires an agent-id (use 'kl list' to see active sessions)"
    local id="$1"
    require_tool tmux
    tmux has-session -t "$id" 2>/dev/null || die "no tmux session: $id"
    enter_session "$id"
}

# Resume a prior session by name. Reads $AGENT_HOME/state/sessions/<id>/meta.json
# to recover the pi session JSONL path + original cwd, then spawns a tmux
# session named <id> running pi --session <jsonl>. If a tmux session with
# that name is already alive, attach instead. Extra args after <agent-id>
# are passed through to pi (model overrides, etc.).
cmd_resume() {
    [ $# -ge 1 ] || die "resume requires an agent-id (use 'kl list' to see active sessions)"
    local id="$1"; shift

    # Locate which agent home owns the snapshot. Priority:
    #   1. Parse the agent-name prefix and try $KL_AGENTS_DIR/<prefix>.
    #   2. If no match, scan every installed agent for state/sessions/<id>/.
    #      Exactly one match -> use it. Multiple matches -> hard error
    #      (genuinely ambiguous). Zero matches -> proceed to step 3.
    #   3. If $AGENT_HOME is explicitly set, honor it (escape-hatch).
    #   4. Otherwise hard error — silently falling through to the default
    #      starter would just hide a stale or misspelled session-id.
    local agent_home="" name
    name="$(agent_name_from_session_id "$id")"
    if [ -n "$name" ] && [ -d "$KL_AGENTS_DIR/$name" ] \
       && [ -f "$KL_AGENTS_DIR/$name/state/sessions/$id/meta.json" ]; then
        agent_home="$KL_AGENTS_DIR/$name"
    fi
    if [ -z "$agent_home" ]; then
        local matches=()
        local h
        while IFS= read -r h; do
            [ -n "$h" ] || continue
            [ -f "$h/state/sessions/$id/meta.json" ] && matches+=("$h")
        done < <(list_agent_homes)
        if [ ${#matches[@]} -eq 1 ]; then
            agent_home="${matches[0]}"
        elif [ ${#matches[@]} -gt 1 ]; then
            local m
            local msg="snapshot for '$id' found in multiple agents — ambiguous:"
            for m in "${matches[@]}"; do msg+=$'\n  '"$m"; done
            msg+=$'\n''Set AGENT_HOME to disambiguate.'
            die "$msg"
        fi
    fi
    if [ -z "$agent_home" ] && [ -n "${AGENT_HOME:-}" ] && [ -d "$AGENT_HOME" ]; then
        agent_home="$AGENT_HOME"
    fi
    if [ -z "$agent_home" ]; then
        die "no agent owns session '$id'.
  Tried prefix lookup ('$name') and scanned $KL_AGENTS_DIR/*/state/sessions/.
  Set AGENT_HOME=<path> if the snapshot lives outside the registry."
    fi
    require_tool tmux

    # If the tmux session is already alive, just attach — same shape as
    # `kl attach <id>`. kl run + a detach leaves the tmux session running;
    # resume should rejoin it instead of spawning a duplicate pi process.
    if tmux has-session -t "$id" 2>/dev/null; then
        echo "kl: attaching existing tmux session $id" >&2
        enter_session "$id"
        return 0
    fi

    local meta="$agent_home/state/sessions/$id/meta.json"
    if [ ! -f "$meta" ]; then
        die "no snapshot for '$id' at $meta
  (sessions started before snapshot tracking won't have one;
   use 'pi --resume' to pick from pi's session list directly)"
    fi

    # Resolve pi_session_jsonl + cwd through state-cli (real JSON.parse). Output
    # is NUL-separated so a cwd containing quotes/tabs/spaces survives intact —
    # the old awk -F'"' split on quotes and could resume in the wrong directory.
    local jsonl cwd
    { IFS= read -r -d '' jsonl; IFS= read -r -d '' cwd; } \
        < <(run_tsx resolve "$id" --home "$agent_home")
    [ -n "$jsonl" ] || die "snapshot meta for '$id' has no pi_session_jsonl field"
    [ -f "$jsonl" ] || die "pi session file recorded for '$id' is gone: $jsonl"
    [ -n "$cwd" ] || cwd="$(pwd)"

    local pi_bin
    pi_bin="$(resolve_pi_bin)"
    # Same extensions/skills/agent dir as `kl run`; no model/thinking
    # defaults (the transcript carries them). Pi restores the prompt from
    # the transcript's recorded sections — no snapshot replay.
    launcher_plan --home "$agent_home" --resume -- --session "$jsonl" "$@"

    # AGENT_ID restoration is what makes the extension reuse the same identity.
    local -a resume_env=(
        -e "AGENT_ID=$id"
        -e "AGENT_HOME=$agent_home"
        -e "_KL=1"
        -e "PI_CODING_AGENT_DIR=$PLAN_PI_DIR"
    )
    [ -z "${KL_ROOT:-}" ] || resume_env+=(-e "KL_ROOT=$KL_ROOT")
    tmux new-session -d -s "$id" -c "$cwd" \
        "${resume_env[@]}" \
        "$pi_bin" ${PLAN_ARGS[@]+"${PLAN_ARGS[@]}"}

    echo "kl: resumed $id (pi session $(basename "$jsonl"))" >&2
    enter_session "$id"
}

cmd_list() {
    require_tool tmux
    # Use @kl marker if we decide to tag kl-owned sessions; for now just list
    # tmux sessions matching our name shape (word-word-word). A stricter filter
    # would require setting a tmux user option on spawn — deferred.
    local sessions
    if ! sessions="$(tmux list-sessions -F '#{session_name}' 2>/dev/null)"; then
        echo "(no tmux server running)"
        return 0
    fi
    local any=0
    while IFS= read -r s; do
        # Heuristic filter: <name>-<adj>-<noun>[-suffix] where name matches
        # the same grammar `kl new` accepts ([a-z][a-z0-9_]*).
        [[ "$s" =~ ^[a-z][a-z0-9_]*-[a-z]+-[a-z]+ ]] || continue
        echo "$s"
        any=1
    done <<< "$sessions"
    [ "$any" = 1 ] || echo "(no kl sessions — use 'tmux list-sessions' for all tmux sessions)"
}

# --- init: create a new agent folder ---
# Compact: agent.yml + SYSTEM.md (that's a whole agent). --full scaffolds a
# persistent agent home. No venv, no copied tools or skills (kl's bundled
# skills load from the repo via --skill).
cmd_init() {
    local name="" full=0 arg
    for arg in "$@"; do
        case "$arg" in
            --full) full=1 ;;
            -*) die "init: unknown flag '$arg' (only --full)" ;;
            *) [ -z "$name" ] || die "init: unexpected argument '$arg'"; name="$arg" ;;
        esac
    done
    [ -n "$name" ] || die "kl init requires an agent name (e.g. 'kl init scout' or 'kl init scout --full')"
    [[ "$name" =~ ^[a-z][a-z0-9_]*$ ]] \
        || die "invalid agent name '$name' — must start with a lowercase letter and contain only [a-z0-9_].
  (Hyphens are reserved: session-ids are <name>-<adj>-<noun>.)"

    local target="$KL_AGENTS_DIR/$name"
    [ ! -e "$target" ] || die "agent '$name' already exists at $target (use 'kl agents' to list)"
    mkdir -p "$target"

    cat > "$target/agent.yml" <<YML
name: $name
description: ""

# Everything below is optional; ~/.kl/config.yml supplies defaults.
# model: openai-codex/gpt-5.6-luna
# thinking: medium
# project_context: true     # false drops AGENTS.md/CLAUDE.md from the prompt
# timestamps: true          # false, or {per_turn, every_calls, every_minutes}
# sections:                 # rendered once at session start, after <session>
#   - {name: notes, path: notes.md}
#   - {name: today, command: "date +%A"}
YML
    cat > "$target/SYSTEM.md" <<MD
<!--
  Identity prompt for $name: who this agent is and how it works.
  It opens the system prompt, before the kl baseline. HTML comments like
  this one are stripped; an empty file means no identity prompt.
-->
MD

    if [ "$full" = 1 ]; then
        mkdir -p "$target"/{memory,scratch,extensions,skills,prompts}
        cat > "$target/prompts/cleanup.md" <<'MD'
<!-- Cleanup turn: runs on /exit and exit_session (also before a continue reset). -->
You're wrapping up. Write a short summary of this session (what you did,
what's still open) to {summary_path}, update anything in memory/ that should
outlast it, then stop.
MD
        cat >> "$target/agent.yml" <<'YML'

# Cleanup turn on /exit and exit_session; memory injected every session.
cleanup: { path: prompts/cleanup.md }
sections:
  - {name: memory, path: memory/MEMORY.md}
YML
        # Empty until the agent writes to it; sections skip empty output.
        : > "$target/memory/MEMORY.md"
        printf 'inbox/\nstate/\nsessions/\n' > "$target/.gitignore"
        if command -v git >/dev/null 2>&1; then
            git -C "$target" init -q && echo "kl: git init $target" >&2
        fi
    fi

    echo "kl: created $([ "$full" = 1 ] && echo "full" || echo "compact") agent '$name' at $target"
    echo "    launch with: kl run $name"
}

# --- agents: list installed agents under $KL_AGENTS_DIR ---
cmd_agents() {
    local found=0
    local home
    while IFS= read -r home; do
        [ -n "$home" ] || continue
        local name
        name="$(basename "$home")"
        # Pull agent.yml name field for sanity-check / display
        local yml_name
        yml_name="$(resolve_agent_name "$home")"
        local marker=""
        [ "$yml_name" != "$name" ] && marker=" (agent.yml name: $yml_name — mismatch)"
        # Sessions count
        local count=0
        if [ -d "$home/state/sessions" ]; then
            count="$(find "$home/state/sessions" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
        fi
        # Description (one-line role, or multi-line block) — blank when unset.
        local desc first rest
        desc="$(resolve_agent_description "$home")"
        first="$(printf '%s' "$desc" | head -n 1)"
        printf '  %-12s  %-13s  %s%s\n' "$name" "$count session(s)" "$first" "$marker"
        rest="$(printf '%s' "$desc" | tail -n +2)"
        if [ -n "$rest" ]; then
            # Align continuation lines under the description column.
            printf '%s\n' "$rest" | while IFS= read -r dl; do
                printf '  %-12s  %-13s  %s\n' "" "" "$dl"
            done
        fi
        found=1
    done < <(list_agent_homes)

    if [ "$found" = 0 ]; then
        echo "(no agents installed under $KL_AGENTS_DIR)"
        echo "  Create one with: kl init <name> [--full]"
        return 0
    fi
}

# --- doctor: diagnostic ---
# Prints a checklist of the things kl depends on + whether each is healthy.
# Meant for "something's wrong and I don't know what" — dump this output
# verbatim when reporting an issue.
cmd_doctor() {
    # Optional positional <name>: scope agent-home checks to one agent.
    # Without it, iterate every installed agent (and the AGENT_HOME
    # override if present and not already covered).
    local explicit_name=""
    if [ $# -gt 0 ] \
       && [[ "$1" =~ ^[a-z][a-z0-9_]*$ ]] \
       && [ -d "$KL_AGENTS_DIR/$1" ]; then
        explicit_name="$1"
        shift
    fi

    local ok=0 fail=0 warn=0
    local pass_pfx="  ok   " fail_pfx="  FAIL " warn_pfx="  warn "

    say_ok()   { echo "${pass_pfx}$*"; ok=$((ok + 1)); }
    say_fail() { echo "${fail_pfx}$*"; fail=$((fail + 1)); }
    say_warn() { echo "${warn_pfx}$*"; warn=$((warn + 1)); }

    echo "kl doctor — kiln-lite diagnostic"
    echo

    # --- SYSTEM SECTION (agent-agnostic) ---

    # 1. Script + repo root
    echo "[paths]"
    echo "  script     $SCRIPT_PATH"
    echo "  repo root  $REPO_ROOT"
    echo "  agents dir $KL_AGENTS_DIR"
    echo "  kl root    ${KL_ROOT:-$HOME/.kl}"
    if [ -f "$REPO_ROOT/extensions/kiln-lite/index.ts" ]; then
        say_ok "core extension entry present"
    else
        say_fail "core extension entry missing at $REPO_ROOT/extensions/kiln-lite/index.ts"
    fi
    if [ -d "${KL_ROOT:-$HOME/.kl}/pi" ]; then
        say_ok "kl pi agent dir present (${KL_ROOT:-$HOME/.kl}/pi)"
    else
        say_warn "kl pi agent dir missing (created on first 'kl run')"
    fi
    echo

    # 2. Prereqs
    echo "[prerequisites]"
    if command -v node >/dev/null 2>&1; then
        say_ok "node: $(node --version 2>/dev/null)"
    else
        say_fail "node not on PATH"
    fi
    local doc_pi
    if doc_pi="$(resolve_pi_bin 2>/dev/null)"; then
        say_ok "pi: $doc_pi ($("$doc_pi" --version 2>/dev/null | head -n 1))"
    else
        say_fail "pi not found (set KL_PI or install @earendil-works/pi-coding-agent >= 1.0.3)"
    fi
    if command -v tmux >/dev/null 2>&1; then
        say_ok "tmux: $(tmux -V 2>/dev/null)"
    else
        say_fail "tmux not on PATH"
    fi
    if command -v kl-msg >/dev/null 2>&1; then
        say_ok "kl-msg: $(command -v kl-msg)"
    else
        say_fail "kl-msg not on PATH (run $REPO_ROOT/install.sh)"
    fi
    echo

    # 3. pi extension registration
    # Expected: NOT registered globally. kl loads the extension via -e <path>;
    # bare `pi` is intentionally extension-free (so e.g. quick one-off pi
    # runs don't spin up daemon/tmux plumbing). If kiln-lite shows up in
    # `pi list`, it's a leftover from an older install.sh that did
    # `pi install .` — the current install.sh removes it.
    echo "[pi registration]"
    if command -v pi >/dev/null 2>&1; then
        local pi_out
        if pi_out="$(pi list 2>&1)"; then
            if echo "$pi_out" | grep -q "kiln-lite"; then
                say_warn "kiln-lite is registered globally with pi — this is legacy state."
                say_warn "bare 'pi' will now auto-load kiln-lite (probably not what you want)."
                say_warn "run: pi remove kiln-lite   (or rerun install.sh to clean up)"
            else
                say_ok "kiln-lite not in 'pi list' — kl loads the extension directly via -e"
            fi
        else
            say_warn "pi list failed: $pi_out"
        fi
    fi
    echo

    # 4. Daemon
    echo "[daemon]"
    local sock="${XDG_RUNTIME_DIR:-/tmp}/kiln-lite.sock"
    [ -n "${XDG_RUNTIME_DIR:-}" ] || sock="/tmp/kiln-lite-$(id -u).sock"
    echo "  socket     $sock"
    if [ -S "$sock" ]; then
        say_ok "socket file exists"
        if command -v kl-msg >/dev/null 2>&1; then
            # Minimal ping — status call returns quickly if the daemon is up.
            # kl-msg needs AGENT_ID/AGENT_HOME even for status; fake if unset.
            local probe_home="${AGENT_HOME:-$KL_AGENTS_DIR/agent}"
            local probe_id="kl-doctor-$$"
            if AGENT_ID="${AGENT_ID:-$probe_id}" \
               AGENT_HOME="$probe_home" \
               kl-msg status >/dev/null 2>&1; then
                say_ok "daemon responds to status"
            else
                say_warn "daemon socket present but 'kl-msg status' failed — stale socket?"
            fi
        fi
    else
        say_warn "no daemon socket (will autostart on first kl-msg call)"
    fi
    echo

    # 5. Current env
    echo "[current env]"
    echo "  AGENT_ID       ${AGENT_ID:-(unset)}"
    echo "  AGENT_HOME     ${AGENT_HOME:-(unset)}"
    echo "  KL_AGENTS_DIR  ${KL_AGENTS_DIR}"
    echo "  _KL            ${_KL:-(unset)}"
    echo "  TMUX           ${TMUX:-(unset)}"
    echo

    # --- PER-AGENT SECTION ---

    # Build list of homes to check.
    local -a homes=()
    if [ -n "$explicit_name" ]; then
        homes+=("$KL_AGENTS_DIR/$explicit_name")
    else
        local h
        while IFS= read -r h; do
            [ -n "$h" ] && homes+=("$h")
        done < <(list_agent_homes)
        # Include AGENT_HOME if set and not already included
        if [ -n "${AGENT_HOME:-}" ] && [ -d "$AGENT_HOME" ]; then
            local seen=0
            for h in ${homes[@]+"${homes[@]}"}; do
                [ "$h" = "$AGENT_HOME" ] && { seen=1; break; }
            done
            [ "$seen" = 0 ] && homes+=("$AGENT_HOME")
        fi
    fi

    if [ ${#homes[@]} -eq 0 ]; then
        echo "[agents]"
        say_warn "no agent homes found under $KL_AGENTS_DIR"
        say_warn "  scaffold one with: kl init <name>   or run install.sh"
        echo
    fi

    local home
    for home in ${homes[@]+"${homes[@]}"}; do
        local short="${home/#$HOME/~}"
        echo "[agent: $short]"
        if [ -d "$home" ]; then
            say_ok "directory exists"
            if [ -f "$home/agent.yml" ]; then
                say_ok "agent.yml present"
            else
                say_warn "agent.yml missing"
            fi
            [ -d "$home/skills" ] && say_ok "skills/ present"
            [ -d "$home/extensions" ] && say_ok "extensions/ present"
            if [ -f "$home/harness/index.ts" ]; then
                say_warn "harness/index.ts is no longer loaded — move it to extensions/"
            fi
            if [ -d "$home/tools" ] || [ -d "$home/venv" ]; then
                say_warn "tools/ or venv/ present — kl no longer puts these on PATH"
            fi
        else
            say_fail "directory does not exist: $home"
        fi
        echo
    done

    # Summary
    echo "summary: ok=$ok warn=$warn fail=$fail"
    [ "$fail" = 0 ]
}

# --- history: show recent sessions from snapshot meta ---
# Scans state/sessions/*/meta.json, sorts by last_seen descending.
# Useful for finding sessions that crashed without clean exit.
#
# Without a name arg, walks every agent under $KL_AGENTS_DIR (plus the
# AGENT_HOME override if set). With a name arg, scopes to that agent.
cmd_history() {
    # Strict arg parse: optional positional <name>, -n <int>, --all.
    # Unknown flags and unknown/invalid agent names error rather than
    # silently falling through to "all agents".
    local explicit_name="" limit=20 all_mode=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -n)
                shift
                case "${1:-}" in
                    ""|*[!0-9]*) die "history: -n requires a non-negative integer (got '${1:-}')" ;;
                esac
                limit="$1"
                ;;
            --all)
                all_mode=1
                ;;
            -*)
                die "history: unknown flag '$1' (use -n <N> or --all)"
                ;;
            *)
                [ -z "$explicit_name" ] || die "history: unexpected argument '$1'"
                [[ "$1" =~ ^[a-z][a-z0-9_]*$ ]] || die "history: '$1' is not a valid agent name"
                [ -d "$KL_AGENTS_DIR/$1" ] || die "history: no agent '$1' under $KL_AGENTS_DIR"
                explicit_name="$1"
                ;;
        esac
        shift
    done

    # Build the list of agent homes to scan.
    local -a homes=()
    if [ -n "$explicit_name" ]; then
        homes+=("$KL_AGENTS_DIR/$explicit_name")
    else
        # All installed agents, plus AGENT_HOME if set and not already included.
        local h
        while IFS= read -r h; do
            [ -n "$h" ] && homes+=("$h")
        done < <(list_agent_homes)
        if [ -n "${AGENT_HOME:-}" ] && [ -d "$AGENT_HOME" ]; then
            local seen=0
            for h in ${homes[@]+"${homes[@]}"}; do
                [ "$h" = "$AGENT_HOME" ] && { seen=1; break; }
            done
            [ "$seen" = 0 ] && homes+=("$AGENT_HOME")
        fi
    fi

    if [ ${#homes[@]} -eq 0 ]; then
        echo "(no agents found — run '$REPO_ROOT/install.sh' or 'kl init <name>')"
        return 0
    fi

    require_tool tmux

    # One snapshot of live tmux session names; membership tested in-process
    # below (replaces the old per-row `tmux has-session` spawn).
    local live_sessions
    live_sessions="$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)"

    # Hand state-cli the homes that actually have a snapshot dir. It reads the
    # recency journal (rebuilding from meta files if missing), dedupes, sorts
    # newest-first, and emits a bounded TSV — so the shell never opens or
    # parses a single meta.json. --all switches it to an exact full scan.
    local -a cli_args=(history)
    local home have_home=0
    for home in "${homes[@]}"; do
        [ -d "$home/state/sessions" ] || continue
        cli_args+=(--home "$home")
        have_home=1
    done
    if [ "$have_home" = 0 ]; then
        echo "(no session history found)"
        return 0
    fi
    if [ "$all_mode" = 1 ]; then
        cli_args+=(--all)
    else
        cli_args+=(--limit "$limit")
    fi

    local out
    out="$(run_tsx "${cli_args[@]}")"
    if [ -z "$out" ]; then
        echo "(no session history found)"
        return 0
    fi

    # TSV in: last_seen \t agent_id \t model \t cwd \t home (already sorted+limited).
    printf "%-24s  %-22s  %-5s  %-30s  %s\n" "LAST SEEN" "SESSION" "STATE" "MODEL" "CWD"
    while IFS=$'\t' read -r ts id model cwd home; do
        [ -n "$id" ] || continue
        # Live? exact membership against the one-shot tmux snapshot.
        local status="-"
        case $'\n'"$live_sessions"$'\n' in
            *$'\n'"$id"$'\n'*) status="live" ;;
        esac
        # Presentation-only transforms.
        local display_ts="${ts%%.*}"      # drop fractional seconds
        display_ts="${display_ts/T/ }"     # T -> space
        model="${model##*/}"               # strip provider prefix
        if [ "$cwd" = "$HOME" ]; then
            cwd="~"
        elif [ "${cwd#$HOME/}" != "$cwd" ]; then
            cwd="~/${cwd#$HOME/}"
        fi
        printf "%-24s  %-22s  %-5s  %-30s  %s\n" "$display_ts" "$id" "$status" "$model" "$cwd"
    done <<< "$out"
}

# --- main ---

main() {
    case "${1:-}" in
        run) shift; cmd_run "$@" ;;
        resume) shift; cmd_resume "$@" ;;
        attach) shift; cmd_attach "$@" ;;
        list|ls) shift; cmd_list "$@" ;;
        agents) shift; cmd_agents "$@" ;;
        init|new) shift; cmd_init "$@" ;;
        history) shift; cmd_history "$@" ;;
        doctor) shift; cmd_doctor "$@" ;;
        -h|--help|help) usage ;;
        # Bare `kl` (optionally with flags) is an alias for `kl run` against
        # the default agent. Empty or flag-leading invocations route to
        # cmd_run; cmd_run still does leading-positional <name> detection for
        # the explicit `kl run <name>` path.
        "") cmd_run ;;
        -*) cmd_run "$@" ;;
        # A non-flag leading token that isn't a known subcommand is an
        # unknown command — NOT a prompt and NOT an agent-launch shortcut.
        # `kl <name>` used to silently spawn a session whose prompt was the
        # typo'd token; error instead and point at the canonical path.
        *) die "unknown command '$1'.
  Run 'kl --help' for usage.
  To launch an agent:    kl run $1
  To launch the default: kl" ;;
    esac
}

main "$@"
