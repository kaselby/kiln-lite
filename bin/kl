#!/usr/bin/env bash
# kl — kiln-lite: run Pi agents in tmux, by name.
#
# Every session is a Pi session UUID with a name (<agent>-<adj>-<noun>)
# drawn at launch: unique among running sessions, avoiding names used in
# the last 3 weeks. The registry is <kl root>/run/sessions/<uuid>.yml;
# running processes hold a lease in run/leases/. Anything below that takes
# a <session> accepts a name, name@<id-prefix> (when a name was reused) or
# @<id-prefix>. A plain name means the running session with that name, else
# the one that used it most recently.
#
# Subcommands:
#   kl run [<agent>] [--detach] [--prompt-file FILE] [--parent SESSION]
#          [--wake park|auto] [pi-args...]
#                           Start a new session of <agent> ($KL_AGENTS_DIR/<agent>;
#                           default: $AGENT_HOME, else the starter "agent") and
#                           attach to it. Inside a kl session (SESSION_UUID set)
#                           run, resume and attach never attach: they act as
#                           --detach and say so.
#                           --detach (-d): don't attach; print the name on stdout:
#                             name=$(kl run reviewer -d --prompt-file brief.md)
#                           --prompt-file FILE: the initial prompt, read from a
#                             file (never goes through a shell).
#                           --parent SESSION: the session that launched this one
#                             (a name or UUID; stored as a UUID).
#                           A bare word that isn't an installed agent is an
#                           error, not a prompt.
#   kl [--detach] [pi-args...]
#                           Same as `kl run` with the default agent.
#   kl resume <session> [--detach] [pi-args...]
#   kl attach <session> [--detach]
#                           Attach to a session, starting it again first if it
#                           isn't running (same name unless another running
#                           session holds it). Mail parked while it was down is
#                           delivered when it starts. --detach: start it if
#                           needed, print the name, don't attach.
#   kl sessions [-n N] [--all] [--json]
#                           Recent sessions as parent/child trees; * = running,
#                           with what each is doing (its plan's goal).
#   kl sessions <session> [--json]
#                           One session in full: state, parent and children,
#                           cwd, transcript, plan, status.
#   kl message <command>    Send and read messages: send, subscribe,
#                           unsubscribe, channels, history, status.
#                           kl message --help for details.
#   kl agents               Installed agents under $KL_AGENTS_DIR.
#   kl init <name> [--full] Create an agent at $KL_AGENTS_DIR/<name>. Compact
#                           (default): agent.yml + SYSTEM.md. --full adds
#                           memory/ scratch/ extensions/ skills/ prompts/, a
#                           cleanup prompt, a memory section, and git init.
#                           (`kl new` is an alias.)
#   kl doctor [<name>]      Diagnostics: system checks, then every installed
#                           agent (or just <name>).
#   kl install <pkg> [flags]
#                           pi install into the kl-wide pi dir (<kl root>/pi):
#                           the package loads for every kl agent.
#   kl migrate [--dry-run] [<agent-home>...]
#                           Convert old agent homes in place (agent.yml.bak
#                           kept). Default: every agent in $KL_AGENTS_DIR.
#   kl -h | --help          Show this help.
#
# Env:
#   KL_AGENTS_DIR           Parent dir for agent homes (default: ~/.kl/agents).
#   AGENT_HOME              Explicit agent home for `kl run` with no <agent>.
#   KL_ROOT                 kl root (default: ~/.kl): config.yml, pi/ (the
#                           kl-wide PI_CODING_AGENT_DIR), run/ (sessions,
#                           leases, inboxes), daemon/.
#   KL_PI                   pi binary (default: the repo's node_modules/.bin/pi
#                           if present, else pi on PATH).
#   KL_TMUX_SOCKET          Use a private tmux server (tmux -L <socket>) for
#                           every tmux call. For isolated test runs.

set -euo pipefail

# --- resolve real script dir (follow symlinks — npm bin is symlinked) ---
# `npm link` creates two layers of symlinks: a direct symlink on the bin
# (`bin/kl` -> `node_modules/kiln-lite/bin/kl`) AND a symlinked DIRECTORY
# (`node_modules/kiln-lite` -> `~/Git/kiln-lite`). The readlink loop walks
# the first kind, but we need `cd -P` to resolve symlinked parent
# directories so REPO_ROOT ends up at the real on-disk path. Skipping -P
# leaves REPO_ROOT pointing at the npm-linked copy — any tooling that
# re-resolves paths relative to cwd or realpath can diverge from there,
# producing "kiln-lite not registered" style confusion.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
    _dir="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd -P)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$_dir/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd -P)"
REPO_ROOT="$(cd -P "$SCRIPT_DIR/.." && pwd -P)"

# The pi command line (extensions, skills, model/thinking defaults, the kl
# Pi agent dir) is built by src/launcher.ts from the merged ~/.kl/config.yml
# + agent.yml (src/sessions/launch.ts calls it). There is no harness override:
# agents extend kl with ordinary Pi extensions in <home>/extensions/.

die() { echo "kl: $*" >&2; exit 1; }

# --- agent-home resolution ---
#
# Single source of truth for "where does this agent live on disk?". Used
# by run/doctor so the priority order stays consistent.
KL_AGENTS_DIR="${KL_AGENTS_DIR:-$HOME/.kl/agents}"

# Resolve an agent home from an optional name.
#
# Priority:
#   1. Explicit name        -> $KL_AGENTS_DIR/<name>   (must exist)
#   2. $AGENT_HOME env var  -> use as-is               (must exist)
#   3. Default              -> $KL_AGENTS_DIR/agent    (must exist)
#
# Exits non-zero with a helpful message if no agent can be resolved.
resolve_agent_home() {
    local name="${1:-}"
    if [ -n "$name" ]; then
        local home="$KL_AGENTS_DIR/$name"
        if [ -d "$home" ]; then
            printf '%s' "$home"; return
        fi
        die "no agent named '$name' at $home (use 'kl init $name' to create, or 'kl agents' to list)"
    fi
    if [ -n "${AGENT_HOME:-}" ]; then
        if [ -d "$AGENT_HOME" ]; then
            printf '%s' "$AGENT_HOME"; return
        fi
        die "AGENT_HOME=$AGENT_HOME does not exist"
    fi
    local default_home="$KL_AGENTS_DIR/agent"
    if [ -d "$default_home" ]; then
        printf '%s' "$default_home"; return
    fi
    die "no agent home found.
  Tried: \$KL_AGENTS_DIR/agent  -> $default_home
         \$AGENT_HOME            -> (unset)
  Run '$REPO_ROOT/install.sh' to scaffold a starter agent, or 'kl init <name>' to create one."
}

# Iterate installed agent homes (one per line). No output if none exist.
list_agent_homes() {
    [ -d "$KL_AGENTS_DIR" ] || return 0
    local d
    for d in "$KL_AGENTS_DIR"/*/; do
        [ -d "$d" ] || continue
        # Only count dirs that look like an agent home (have agent.yml).
        [ -f "${d}agent.yml" ] || continue
        # Strip trailing slash
        printf '%s\n' "${d%/}"
    done
}

usage() {
    # Print the top-of-file comment block (up to the first blank or non-comment line).
    awk '
        NR == 1 { next }                 # skip shebang
        /^[^#]/ { exit }                 # stop at first non-comment line
        /^#$/ { print ""; next }         # blank-comment -> blank line
        /^# ?/ { sub(/^# ?/, ""); print }
    ' "$SCRIPT_PATH"
    exit 1
}

# Parse `name:` from agent.yml without bringing in a yaml dep. Trivial
# for the shape our scaffold uses; fine for more complex yaml too since we
# only match a top-level `name:` line.
resolve_agent_name() {
    local agent_home="${1:-$HOME/.kl/agent}"
    if [ -f "$agent_home/agent.yml" ]; then
        local n
        n="$(awk '/^name:[[:space:]]*/{sub(/^name:[[:space:]]*/,""); gsub(/[\"'\''[:space:]]/,""); print; exit}' "$agent_home/agent.yml")"
        if [ -n "$n" ]; then
            printf '%s' "$n"
            return
        fi
    fi
    printf 'agent'
}

# Parse `description:` from agent.yml. Returns empty if unset. Handles both
# inline form (description: "..." or bare) and YAML block scalars
# (description: | / >), emitting multi-line block content with its indentation
# stripped. Descriptions are prose, so we keep internal spaces and don't strip
# comments — only outer whitespace and one layer of quotes on the inline form.
resolve_agent_description() {
    local agent_home="$1"
    [ -f "$agent_home/agent.yml" ] || return 0
    awk '
        /^description:[[:space:]]*/ {
            line=$0
            sub(/^description:[[:space:]]*/, "", line)
            if (line ~ /^[|>]/) { block=1; next }   # block scalar: collect indented lines
            sub(/[[:space:]]+$/, "", line)
            sub(/^["'\'']/, "", line); sub(/["'\'']$/, "", line)
            print line; exit
        }
        block {
            if ($0 ~ /^[[:space:]]*$/) exit        # blank line ends the block
            if ($0 ~ /^[^[:space:]]/) exit         # dedent (next key/comment) ends it
            s=$0; sub(/^[[:space:]]+/, "", s); print s
        }
    ' "$agent_home/agent.yml"
}

# --- tmux helpers ---

require_tool() {
    local tool="$1" hint="${2:-}"
    command -v "$tool" >/dev/null 2>&1 || die "$tool not found on PATH${hint:+ — $hint}"
}

# tsx (a direct dependency): the package's own copy, else tsx on PATH.
tsx_path() {
    local tsx_bin="$REPO_ROOT/node_modules/.bin/tsx"
    if [ ! -x "$tsx_bin" ]; then
        tsx_bin="$(command -v tsx 2>/dev/null || true)"
    fi
    [ -n "$tsx_bin" ] || die "tsx not found (expected $REPO_ROOT/node_modules/.bin/tsx — run install.sh)"
    printf '%s' "$tsx_bin"
}

# pi binary: $KL_PI, else the repo's pinned dev copy, else pi on PATH.
resolve_pi_bin() {
    if [ -n "${KL_PI:-}" ]; then
        [ -x "$KL_PI" ] || die "KL_PI=$KL_PI is not executable"
        printf '%s' "$KL_PI"; return
    fi
    if [ -x "$REPO_ROOT/node_modules/.bin/pi" ]; then
        printf '%s' "$REPO_ROOT/node_modules/.bin/pi"; return
    fi
    command -v pi 2>/dev/null || die "pi not found — install @earendil-works/pi-coding-agent >= 1.0.3 or set KL_PI"
}

# --- subcommands ---

# The session commands live in src/sessions/cli.ts (registry, leases,
# name resolution, wake). bash only resolves the agent home for `run`.
sessions_cli() {
    require_tool tmux "install with: brew install tmux"
    exec "$(tsx_path)" "$REPO_ROOT/src/sessions/cli.ts" "$@"
}

cmd_run() {
    # Optional first positional: agent name. A bare word matching the agent
    # name grammar (^[a-z][a-z0-9_]*$) is always an intended agent name: it
    # resolves under $KL_AGENTS_DIR or errors. It is never sent to pi as a
    # prompt. Everything else (flags, `--`, a quoted prompt) passes through.
    local explicit_name=""
    if [ $# -gt 0 ] && [[ "$1" =~ ^[a-z][a-z0-9_]*$ ]]; then
        explicit_name="$1"
        shift
    fi
    local agent_home
    agent_home="$(resolve_agent_home "$explicit_name")"
    # The pre-launch hook (<home>/hooks/pre-launch) runs in launchNew.
    sessions_cli run --home "$agent_home" "$@"
}

# `kl install <pkg> [pi install flags]`: pi install into the kl-wide pi dir
# (<kl root>/pi), so the package loads for every kl agent and not base pi.
cmd_install() {
    [ $# -gt 0 ] || die "install needs a package (e.g. kl install npm:@scope/pkg)"
    local pi_dir
    pi_dir="$("$(tsx_path)" "$REPO_ROOT/src/launcher.ts" pi-dir)" || exit 1
    PI_CODING_AGENT_DIR="$pi_dir" exec "$(resolve_pi_bin)" install "$@"
}

cmd_init() {
    local name="" full=0 arg
    for arg in "$@"; do
        case "$arg" in
            --full) full=1 ;;
            -*) die "init: unknown flag '$arg' (only --full)" ;;
            *) [ -z "$name" ] || die "init: unexpected argument '$arg'"; name="$arg" ;;
        esac
    done
    [ -n "$name" ] || die "kl init requires an agent name (e.g. 'kl init scout' or 'kl init scout --full')"
    [[ "$name" =~ ^[a-z][a-z0-9_]*$ ]] \
        || die "invalid agent name '$name' — must start with a lowercase letter and contain only [a-z0-9_].
  (Hyphens are reserved: session-ids are <name>-<adj>-<noun>.)"

    local target="$KL_AGENTS_DIR/$name"
    [ ! -e "$target" ] || die "agent '$name' already exists at $target (use 'kl agents' to list)"
    mkdir -p "$target"

    cat > "$target/agent.yml" <<YML
name: $name
description: ""

# Everything below is optional; ~/.kl/config.yml supplies defaults.
# model: openai-codex/gpt-5.6-luna
# thinking: medium
# project_context: true     # false drops AGENTS.md/CLAUDE.md from the prompt
# timestamps: true          # false, or {per_turn, every_calls, every_minutes}
# sections:                 # rendered once at session start, after <session>
#   - {name: notes, path: notes.md}
#   - {name: today, command: "date +%A"}
YML
    cat > "$target/SYSTEM.md" <<MD
<!--
  Identity prompt for $name: who this agent is and how it works.
  It opens the system prompt, before the kl baseline. HTML comments like
  this one are stripped; an empty file means no identity prompt.
-->
MD

    if [ "$full" = 1 ]; then
        mkdir -p "$target"/{memory/sessions,scratch,extensions,skills,prompts}
        cat > "$target/prompts/cleanup.md" <<'MD'
<!-- Cleanup turn: runs on /exit and exit_session (also before a continue reset). -->
You're wrapping up. Write a short summary of this session (what you did,
what's still open) to memory/sessions/<today's date>-<your session name>.md,
update anything in memory/ that should outlast it, then stop.
MD
        cat >> "$target/agent.yml" <<'YML'

# Cleanup turn on /exit and exit_session; memory injected every session.
cleanup: { path: prompts/cleanup.md }
sections:
  - {name: memory, path: memory/MEMORY.md}
YML
        # Empty until the agent writes to it; sections skip empty output.
        : > "$target/memory/MEMORY.md"
        if command -v git >/dev/null 2>&1; then
            git -C "$target" init -q && echo "kl: git init $target" >&2
        fi
    fi

    echo "kl: created $([ "$full" = 1 ] && echo "full" || echo "compact") agent '$name' at $target"
    echo "    launch with: kl run $name"
}

# --- agents: list installed agents under $KL_AGENTS_DIR ---
cmd_agents() {
    local found=0
    local home
    while IFS= read -r home; do
        [ -n "$home" ] || continue
        local name
        name="$(basename "$home")"
        # Pull agent.yml name field for sanity-check / display
        local yml_name
        yml_name="$(resolve_agent_name "$home")"
        local marker=""
        [ "$yml_name" != "$name" ] && marker=" (agent.yml name: $yml_name — mismatch)"
        # Sessions count
        # Sessions count: registry entries for this agent.
        local count=0 reg="${KL_ROOT:-$HOME/.kl}/run/sessions"
        if [ -d "$reg" ]; then
            count="$(grep -lx "agent: $yml_name" "$reg"/*.yml 2>/dev/null | wc -l | tr -d ' ')"
        fi
        # Description (one-line role, or multi-line block) — blank when unset.
        local desc first rest
        desc="$(resolve_agent_description "$home")"
        first="$(printf '%s' "$desc" | head -n 1)"
        printf '  %-12s  %-13s  %s%s\n' "$name" "$count session(s)" "$first" "$marker"
        rest="$(printf '%s' "$desc" | tail -n +2)"
        if [ -n "$rest" ]; then
            # Align continuation lines under the description column.
            printf '%s\n' "$rest" | while IFS= read -r dl; do
                printf '  %-12s  %-13s  %s\n' "" "" "$dl"
            done
        fi
        found=1
    done < <(list_agent_homes)

    if [ "$found" = 0 ]; then
        echo "(no agents installed under $KL_AGENTS_DIR)"
        echo "  Create one with: kl init <name> [--full]"
        return 0
    fi
}

# --- doctor: diagnostic ---
# Prints a checklist of the things kl depends on + whether each is healthy.
# Meant for "something's wrong and I don't know what" — dump this output
# verbatim when reporting an issue.
cmd_doctor() {
    # Optional positional <name>: scope agent-home checks to one agent.
    # Without it, iterate every installed agent (and the AGENT_HOME
    # override if present and not already covered).
    local explicit_name=""
    if [ $# -gt 0 ] \
       && [[ "$1" =~ ^[a-z][a-z0-9_]*$ ]] \
       && [ -d "$KL_AGENTS_DIR/$1" ]; then
        explicit_name="$1"
        shift
    fi

    local ok=0 fail=0 warn=0
    local pass_pfx="  ok   " fail_pfx="  FAIL " warn_pfx="  warn "

    say_ok()   { echo "${pass_pfx}$*"; ok=$((ok + 1)); }
    say_fail() { echo "${fail_pfx}$*"; fail=$((fail + 1)); }
    say_warn() { echo "${warn_pfx}$*"; warn=$((warn + 1)); }

    echo "kl doctor — kiln-lite diagnostic"
    echo

    # --- SYSTEM SECTION (agent-agnostic) ---

    # 1. Script + repo root
    echo "[paths]"
    echo "  script     $SCRIPT_PATH"
    echo "  repo root  $REPO_ROOT"
    echo "  agents dir $KL_AGENTS_DIR"
    echo "  kl root    ${KL_ROOT:-$HOME/.kl}"
    if [ -f "$REPO_ROOT/extensions/kiln-lite/index.ts" ]; then
        say_ok "core extension entry present"
    else
        say_fail "core extension entry missing at $REPO_ROOT/extensions/kiln-lite/index.ts"
    fi
    local kl_pi_dir="${KL_ROOT:-$HOME/.kl}/pi" base_auth="$HOME/.pi/agent/auth.json"
    if [ -d "$kl_pi_dir" ]; then
        say_ok "kl pi dir present ($kl_pi_dir)"
        # ensureKlPiDir only links auth.json when nothing is there. If pi
        # wrote its own file first, kl agents silently miss your pi login.
        if [ -L "$kl_pi_dir/auth.json" ]; then
            say_ok "auth.json -> $(readlink "$kl_pi_dir/auth.json")"
        elif [ -f "$kl_pi_dir/auth.json" ] && [ -e "$base_auth" ]; then
            say_warn "$kl_pi_dir/auth.json is a regular file, not a link to $base_auth: kl agents don't use your pi login"
            say_warn "  fix: mv $kl_pi_dir/auth.json $kl_pi_dir/auth.json.old && ln -s $base_auth $kl_pi_dir/auth.json"
        elif [ ! -e "$kl_pi_dir/auth.json" ] && [ -e "$base_auth" ]; then
            say_warn "$kl_pi_dir/auth.json missing (linked to $base_auth on the next kl run)"
        fi
    else
        say_warn "kl pi dir missing (created on first 'kl run')"
    fi
    echo

    # 2. Prereqs
    echo "[prerequisites]"
    if command -v node >/dev/null 2>&1; then
        say_ok "node: $(node --version 2>/dev/null)"
    else
        say_fail "node not on PATH"
    fi
    local doc_pi=""
    if doc_pi="$(resolve_pi_bin 2>/dev/null)"; then
        say_ok "pi: $doc_pi ($("$doc_pi" --version 2>/dev/null | head -n 1))"
    else
        say_fail "pi not found (set KL_PI or install @earendil-works/pi-coding-agent >= 1.0.3)"
    fi
    if command -v tmux >/dev/null 2>&1; then
        say_ok "tmux: $(tmux -V 2>/dev/null)"
    else
        say_fail "tmux not on PATH"
    fi
    echo

    # 3. Pi packages in the kl pi dir, listed by the pi kl runs. kl loads its
    # own extension with -e, so a kiln-lite package there would load it twice.
    echo "[pi packages ($kl_pi_dir)]"
    if [ -n "$doc_pi" ] && [ -d "$kl_pi_dir" ]; then
        local pi_out
        if pi_out="$(PI_CODING_AGENT_DIR="$kl_pi_dir" "$doc_pi" list 2>&1)"; then
            if echo "$pi_out" | grep -q "kiln-lite"; then
                say_warn "kiln-lite is installed as a pi package in $kl_pi_dir: it loads twice (kl passes it with -e)"
                say_warn "  fix: PI_CODING_AGENT_DIR=$kl_pi_dir $doc_pi remove <the kiln-lite source shown by pi list>"
            else
                say_ok "no kiln-lite package (kl loads it with -e)"
            fi
            echo "$pi_out" | sed 's/^/       /'
        else
            say_warn "pi list failed: $pi_out"
        fi
    fi
    echo

    # 4. Daemon
    echo "[daemon]"
    local sock="${XDG_RUNTIME_DIR:-/tmp}/kiln-lite.sock"
    [ -n "${XDG_RUNTIME_DIR:-}" ] || sock="/tmp/kiln-lite-$(id -u).sock"
    echo "  socket     $sock"
    if [ -S "$sock" ]; then
        say_ok "socket file exists"
        # Minimal ping: status returns quickly if the daemon is up. No
        # SESSION_UUID: kl message runs as the human, no identity needed.
        if env -u SESSION_UUID "$(tsx_path)" "$REPO_ROOT/src/client/cli.ts" status >/dev/null 2>&1; then
            say_ok "daemon responds to status"
        else
            say_warn "daemon socket present but 'kl message status' failed — stale socket?"
        fi
    else
        say_warn "no daemon socket (it starts on first use)"
    fi
    echo

    # 5. Current env
    echo "[current env]"
    echo "  AGENT_ID       ${AGENT_ID:-(unset)}"
    echo "  AGENT_HOME     ${AGENT_HOME:-(unset)}"
    echo "  KL_AGENTS_DIR  ${KL_AGENTS_DIR}"
    echo "  _KL            ${_KL:-(unset)}"
    echo "  TMUX           ${TMUX:-(unset)}"
    echo

    # --- PER-AGENT SECTION ---

    # Build list of homes to check.
    local -a homes=()
    if [ -n "$explicit_name" ]; then
        homes+=("$KL_AGENTS_DIR/$explicit_name")
    else
        local h
        while IFS= read -r h; do
            [ -n "$h" ] && homes+=("$h")
        done < <(list_agent_homes)
        # Include AGENT_HOME if set and not already included
        if [ -n "${AGENT_HOME:-}" ] && [ -d "$AGENT_HOME" ]; then
            local seen=0
            for h in ${homes[@]+"${homes[@]}"}; do
                [ "$h" = "$AGENT_HOME" ] && { seen=1; break; }
            done
            [ "$seen" = 0 ] && homes+=("$AGENT_HOME")
        fi
    fi

    if [ ${#homes[@]} -eq 0 ]; then
        echo "[agents]"
        say_warn "no agent homes found under $KL_AGENTS_DIR"
        say_warn "  scaffold one with: kl init <name>   or run install.sh"
        echo
    fi

    local home
    for home in ${homes[@]+"${homes[@]}"}; do
        local short="${home/#$HOME/~}"
        echo "[agent: $short]"
        if [ -d "$home" ]; then
            say_ok "directory exists"
            if [ -f "$home/agent.yml" ]; then
                say_ok "agent.yml present"
            else
                say_warn "agent.yml missing"
            fi
            [ -d "$home/skills" ] && say_ok "skills/ present"
            [ -d "$home/extensions" ] && say_ok "extensions/ present"
            if [ -e "$home/harness/pre-launch" ]; then
                say_warn "harness/pre-launch is no longer run — kl migrate moves it to hooks/pre-launch"
            fi
            if [ -f "$home/harness/index.ts" ]; then
                say_warn "harness/index.ts is no longer loaded — move it to extensions/"
            fi
            if [ -d "$home/tools" ] || [ -d "$home/venv" ]; then
                say_warn "tools/ or venv/ present — kl no longer puts these on PATH"
            fi
        else
            say_fail "directory does not exist: $home"
        fi
        echo
    done

    # Summary
    echo "summary: ok=$ok warn=$warn fail=$fail"
    [ "$fail" = 0 ]
}

main() {
    case "${1:-}" in
        run) shift; cmd_run "$@" ;;
        resume|attach|sessions) sessions_cli "$@" ;;
        message) shift; exec "$(tsx_path)" "$REPO_ROOT/src/client/cli.ts" "$@" ;;
        agents) shift; cmd_agents "$@" ;;
        init|new) shift; cmd_init "$@" ;;
        doctor) shift; cmd_doctor "$@" ;;
        install) shift; cmd_install "$@" ;;
        migrate) shift; exec "$(tsx_path)" "$REPO_ROOT/src/migrate.ts" "$@" ;;
        -h|--help|help) usage ;;
        # Bare `kl` (optionally with flags) is an alias for `kl run` against
        # the default agent. Empty or flag-leading invocations route to
        # cmd_run; cmd_run still does leading-positional <name> detection for
        # the explicit `kl run <name>` path.
        "") cmd_run ;;
        -*) cmd_run "$@" ;;
        # A non-flag leading token that isn't a known subcommand is an
        # unknown command — NOT a prompt and NOT an agent-launch shortcut.
        # `kl <name>` used to silently spawn a session whose prompt was the
        # typo'd token; error instead and point at the canonical path.
        *) die "unknown command '$1'.
  Run 'kl --help' for usage.
  To launch an agent:    kl run $1
  To launch the default: kl" ;;
    esac
}

main "$@"
