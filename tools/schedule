#!/usr/bin/env bash
# ---
# name: schedule
# brief: Wake this session later or when a process exits
# description: |
#   Creates session-scoped, best-effort wakes. Use `at` with a delay or ISO
#   time, `watch` with a PID, `list` to inspect pending wakes, and `cancel` to
#   remove one. Notes can be passed with --note, --note-file, or stdin.
# arguments: "<at|watch|list|cancel> [options]"
# ---

set -euo pipefail

: "${AGENT_HOME:?AGENT_HOME not set — is kiln-lite loaded?}"
: "${AGENT_ID:?AGENT_ID not set — is kiln-lite loaded?}"

case "$AGENT_ID" in
	*[!A-Za-z0-9._-]*)
		echo "schedule: AGENT_ID contains unsafe path characters: $AGENT_ID" >&2
		exit 2
		;;
esac

STATE_DIR="${AGENT_HOME}/state/scheduled/${AGENT_ID}"
DEFAULT_NOTE="A scheduled wake fired. Check on the thing you were waiting for."

# Resolve the executable before detaching. `$0` is usually already absolute
# because the tools directory is on PATH, but command -v covers bare/manual
# invocation too.
SCRIPT_PATH="$0"
case "$SCRIPT_PATH" in
	*/*) ;;
	*) SCRIPT_PATH="$(command -v -- "$SCRIPT_PATH")" ;;
esac
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
SCRIPT_PATH="${SCRIPT_DIR}/$(basename "$SCRIPT_PATH")"

die() {
	echo "schedule: $*" >&2
	exit 2
}

command -v node >/dev/null 2>&1 || die "node is required"

usage() {
	cat <<'EOF'
Usage:
  schedule at --delay <N[s|m|h|d]> [--note TEXT | --note-file PATH]
  schedule at --time <ISO-8601>     [--note TEXT | --note-file PATH]
                                      (--at-time is an alias for --time)
  schedule watch --pid <PID>        [--note TEXT | --note-file PATH]
  schedule list
  schedule cancel <WAKE_ID>

If neither --note nor --note-file is supplied, non-interactive stdin is used
when it contains text; otherwise a default reminder is recorded. Use
`--note-file -` to explicitly read the note from stdin.

Examples:
  schedule at --delay 10m --note 'Check the build'
  schedule at --time 2026-08-25T17:00:00-04:00 <<'EOF_NOTE'
  Review the benchmark results in /tmp/bench.log.
  EOF_NOTE
  schedule watch --pid 12345 --note 'Inspect the completed job'
  schedule list
  schedule cancel wake-1787690000-a1b2c3d4

Wakes target this exact session ID. They survive session exit and are parked in
its inbox, but detached watchers do not survive machine restart.
EOF
}

require_value() {
	local flag="$1"
	local value="${2:-}"
	[ -n "$value" ] || die "$flag requires a value"
	printf '%s' "$value"
}

new_wake_id() {
	local random
	random="$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
	printf 'wake-%s-%s' "$(date +%s)" "$random"
}

record_path() { printf '%s/%s.record' "$STATE_DIR" "$1"; }
body_path() { printf '%s/%s.body' "$STATE_DIR" "$1"; }
arm_path() { printf '%s/%s.armed' "$STATE_DIR" "$1"; }
error_path() { printf '%s/%s.error' "$STATE_DIR" "$1"; }

valid_wake_id() {
	[[ "$1" =~ ^wake-[0-9]+-[0-9a-f]{8}$ ]]
}

watcher_alive() {
	local pid="$1" wake_id="$2" command
	[[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	command="$(ps -ww -p "$pid" -o command= 2>/dev/null || true)"
	case " $command " in
		*" _run $wake_id "*) return 0 ;;
		*) return 1 ;;
	esac
}

read_note() {
	local note_value="$1" note_file="$2" explicit="$3" note=""
	if [ "$explicit" = "value" ]; then
		note="$note_value"
	elif [ "$explicit" = "file" ]; then
		if [ "$note_file" = "-" ]; then
			note="$(cat)"
		else
			[ -f "$note_file" ] || die "note file does not exist: $note_file"
			note="$(cat "$note_file")"
		fi
	elif [ ! -t 0 ]; then
		note="$(cat)"
	fi
	[ -n "$note" ] || note="$DEFAULT_NOTE"
	printf '%s' "$note"
}

parse_delay_seconds() {
	local delay="$1" number unit multiplier
	[[ "$delay" =~ ^([0-9]+)([smhd])$ ]] || die "bad delay '$delay' — use forms like 30s, 10m, 2h, 1d"
	number="${BASH_REMATCH[1]}"
	unit="${BASH_REMATCH[2]}"
	[ "$number" -gt 0 ] || die "delay must be greater than zero"
	case "$unit" in
		s) multiplier=1 ;;
		m) multiplier=60 ;;
		h) multiplier=3600 ;;
		d) multiplier=86400 ;;
	esac
	# Keep arithmetic within a signed 64-bit shell integer.
	[ "$number" -le $((9223372036854775807 / multiplier)) ] || die "delay is too large"
	printf '%s' "$((number * multiplier))"
}

parse_iso_millis() {
	local value="$1" millis
	command -v node >/dev/null 2>&1 || die "node is required to parse --time"
	if ! millis="$(node -e '
const value = process.argv[1];
const millis = Date.parse(value);
if (!Number.isFinite(millis)) process.exit(2);
process.stdout.write(String(Math.ceil(millis)));
' "$value")"; then
		die "bad time '$value' — use ISO 8601, preferably with a timezone"
	fi
	printf '%s' "$millis"
}

now_millis() {
	node -e 'process.stdout.write(String(Date.now()))'
}

format_millis() {
	node -e 'process.stdout.write(new Date(Number(process.argv[1])).toISOString())' "$1"
}

write_record() {
	local wake_id="$1" kind="$2" target="$3" watcher_pid="$4" created_at="$5"
	local path tmp
	path="$(record_path "$wake_id")"
	tmp="${path}.tmp.$$"
	printf '%s\t%s\t%s\t%s\n' "$kind" "$target" "$watcher_pid" "$created_at" > "$tmp"
	mv "$tmp" "$path"
}

spawn_watcher() {
	local wake_id="$1" kind="$2" target="$3" created_at="$4"
	local watcher_pid

	# The record exists before the worker starts; the .armed file is the gate
	# that prevents a fast trigger from racing the watcher PID update.
	write_record "$wake_id" "$kind" "$target" 0 "$created_at"
	nohup "$SCRIPT_PATH" _run "$wake_id" "$kind" "$target" "$$" >/dev/null 2>&1 &
	watcher_pid=$!
	write_record "$wake_id" "$kind" "$target" "$watcher_pid" "$created_at"
	: > "$(arm_path "$wake_id")"
	printf '%s' "$watcher_pid"
}

schedule_wake() {
	local kind="$1" target="$2" note="$3"
	local wake_id created_at watcher_pid description
	mkdir -p "$STATE_DIR"
	wake_id="$(new_wake_id)"
	created_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	printf '%s\n' "$note" > "$(body_path "$wake_id")"

	if ! watcher_pid="$(spawn_watcher "$wake_id" "$kind" "$target" "$created_at")"; then
		rm -f "$(record_path "$wake_id")" "$(body_path "$wake_id")" "$(arm_path "$wake_id")"
		die "failed to start watcher"
	fi

	if [ "$kind" = "at" ]; then
		local now_ms seconds_away
		now_ms="$(now_millis)"
		seconds_away=$(((target - now_ms + 999) / 1000))
		description="at $(format_millis "$target") (${seconds_away}s from now)"
	else
		description="when PID $target exits"
	fi
	printf 'Wake %s scheduled: fires %s. Watcher pid %s.\n' "$wake_id" "$description" "$watcher_pid"
}

cmd_at() {
	local delay="" at_time="" note_value="" note_file="" note_mode=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--delay)
				[ -z "$delay" ] || die "--delay may be supplied only once"
				delay="$(require_value "$1" "${2:-}")"; shift 2 ;;
			--time|--at-time)
				[ -z "$at_time" ] || die "--time may be supplied only once"
				at_time="$(require_value "$1" "${2:-}")"; shift 2 ;;
			--note)
				[ -z "$note_mode" ] || die "choose only one note source"
				note_value="$(require_value "$1" "${2:-}")"; note_mode="value"; shift 2 ;;
			--note-file)
				[ -z "$note_mode" ] || die "choose only one note source"
				note_file="$(require_value "$1" "${2:-}")"; note_mode="file"; shift 2 ;;
			-h|--help) usage; exit 0 ;;
			*) die "unknown at option: $1" ;;
		esac
	done
	[ -n "$delay" ] || [ -n "$at_time" ] || die "at requires --delay or --time"
	[ -z "$delay" ] || [ -z "$at_time" ] || die "choose either --delay or --time, not both"

	local target now_ms note delay_seconds
	note="$(read_note "$note_value" "$note_file" "$note_mode")"
	now_ms="$(now_millis)"
	if [ -n "$delay" ]; then
		delay_seconds="$(parse_delay_seconds "$delay")"
		[ "$delay_seconds" -le 9223372036854775 ] || die "delay is too large"
		target="$((now_ms + delay_seconds * 1000))"
	else
		target="$(parse_iso_millis "$at_time")"
		[ "$target" -gt "$now_ms" ] || die "--time is in the past"
	fi
	schedule_wake at "$target" "$note"
}

cmd_watch() {
	local pid="" note_value="" note_file="" note_mode=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--pid)
				[ -z "$pid" ] || die "--pid may be supplied only once"
				pid="$(require_value "$1" "${2:-}")"; shift 2 ;;
			--note)
				[ -z "$note_mode" ] || die "choose only one note source"
				note_value="$(require_value "$1" "${2:-}")"; note_mode="value"; shift 2 ;;
			--note-file)
				[ -z "$note_mode" ] || die "choose only one note source"
				note_file="$(require_value "$1" "${2:-}")"; note_mode="file"; shift 2 ;;
			-h|--help) usage; exit 0 ;;
			*) die "unknown watch option: $1" ;;
		esac
	done
	[[ "$pid" =~ ^[1-9][0-9]*$ ]] || die "watch requires a positive integer --pid"
	kill -0 "$pid" 2>/dev/null || die "PID $pid is not alive"
	local note
	note="$(read_note "$note_value" "$note_file" "$note_mode")"
	schedule_wake watch "$pid" "$note"
}

cmd_list() {
	mkdir -p "$STATE_DIR"
	local found=0 file wake_id kind target watcher_pid created_at status description preview error
	for file in "$STATE_DIR"/*.record; do
		[ -f "$file" ] || continue
		found=$((found + 1))
		wake_id="$(basename "$file" .record)"
		if ! IFS=$'\t' read -r kind target watcher_pid created_at < "$file"; then
			printf -- '- %s: unreadable record\n' "$wake_id"
			continue
		fi
		if watcher_alive "$watcher_pid" "$wake_id"; then status="alive"; else status="DEAD"; fi
		if [ "$kind" = "at" ] && [[ "$target" =~ ^[0-9]+$ ]]; then
			description="fires $(format_millis "$target")"
		elif [ "$kind" = "watch" ]; then
			description="watching pid $target"
		else
			description="invalid target"
		fi
		preview="$(head -n 1 "$(body_path "$wake_id")" 2>/dev/null || true)"
		printf -- '- %s [%s] %s — watcher %s (pid %s)\n  note: %s\n' \
			"$wake_id" "$kind" "$description" "$status" "$watcher_pid" "$preview"
		error="$(error_path "$wake_id")"
		if [ -s "$error" ]; then printf '  error: %s\n' "$(head -n 1 "$error")"; fi
	done
	if [ "$found" -eq 0 ]; then
		echo "No pending wakes."
	fi
}

cmd_cancel() {
	[ $# -eq 1 ] || die "cancel requires exactly one WAKE_ID"
	local wake_id="$1" record kind target watcher_pid created_at
	valid_wake_id "$wake_id" || die "invalid wake ID: $wake_id"
	record="$(record_path "$wake_id")"
	[ -f "$record" ] || die "no such wake: $wake_id"
	IFS=$'\t' read -r kind target watcher_pid created_at < "$record" || die "unreadable record: $wake_id"
	if watcher_alive "$watcher_pid" "$wake_id"; then
		kill -TERM "$watcher_pid" 2>/dev/null || true
	fi
	rm -f "$record" "$(body_path "$wake_id")" "$(arm_path "$wake_id")" \
		"$(error_path "$wake_id")" "$(error_path "$wake_id").attempt"
	printf 'Wake %s cancelled.\n' "$wake_id"
}

run_worker() {
	[ $# -eq 4 ] || exit 2
	local wake_id="$1" kind="$2" target="$3" parent_pid="$4"
	valid_wake_id "$wake_id" || exit 2
	local record body armed error attempt_error child_pid="" attempts=0 summary remaining
	record="$(record_path "$wake_id")"
	body="$(body_path "$wake_id")"
	armed="$(arm_path "$wake_id")"
	error="$(error_path "$wake_id")"
	attempt_error="${error}.attempt"

	# Signal traps invoke this indirectly.
	# shellcheck disable=SC2329
	worker_cancel() {
		if [ -n "$child_pid" ]; then kill -TERM "$child_pid" 2>/dev/null || true; fi
		exit 0
	}
	trap worker_cancel TERM INT

	# Wait for the parent to persist our PID and arm the wake. If it dies first,
	# abandon the worker; the incomplete record remains visible for cleanup.
	while [ ! -f "$armed" ]; do
		kill -0 "$parent_pid" 2>/dev/null || exit 1
		sleep 0.05
	done
	[ -f "$record" ] && [ -f "$body" ] || exit 0

	case "$kind" in
		at)
			remaining="$(node -e '
const target = Number(process.argv[1]);
process.stdout.write(String(Math.max(0, target - Date.now()) / 1000));
' "$target")"
			sleep "$remaining" & child_pid=$!
			wait "$child_pid" || exit 0
			child_pid=""
			summary="Scheduled wake"
			;;
		watch)
			while kill -0 "$target" 2>/dev/null; do
				sleep 2 & child_pid=$!
				wait "$child_pid" || exit 0
				child_pid=""
			done
			summary="Watched process $target exited"
			;;
		*) exit 2 ;;
	esac

	# Keep state on failure so `schedule list` exposes the lost watcher instead
	# of silently claiming success. Transient daemon startup failures get retries.
	# During a rolling upgrade an older kl-msg/daemon will not know deliver-self;
	# fall back to the historical self-DM path only for that exact compatibility
	# error. Other failures retain state and retry without creating phantom
	# presence through send_direct.
	while [ "$attempts" -lt 3 ]; do
		attempts=$((attempts + 1))
		if kl-msg deliver-self "$summary" --body-stdin < "$body" 2> "$attempt_error"; then
			rm -f "$record" "$body" "$armed" "$error" "$attempt_error"
			exit 0
		fi
		if grep -Eq 'unknown subcommand: deliver-self|unknown message type: deliver_self' "$attempt_error" &&
			kl-msg send "$AGENT_ID" "$summary" --body-stdin < "$body"; then
			rm -f "$record" "$body" "$armed" "$error" "$attempt_error"
			exit 0
		fi
		rm -f "$attempt_error"
		[ "$attempts" -lt 3 ] || break
		sleep 2 & child_pid=$!
		wait "$child_pid" || exit 0
		child_pid=""
	done
	printf 'delivery failed after %s attempts at %s\n' "$attempts" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$error"
	exit 1
}

main() {
	local command="${1:-}"
	case "$command" in
		at) shift; cmd_at "$@" ;;
		watch) shift; cmd_watch "$@" ;;
		list) shift; [ $# -eq 0 ] || die "list takes no arguments"; cmd_list ;;
		cancel) shift; cmd_cancel "$@" ;;
		-h|--help|help) usage ;;
		_run) shift; run_worker "$@" ;;
		"") usage >&2; exit 2 ;;
		*) die "unknown command: $command" ;;
	esac
}

main "$@"
